# AI Photo Booth Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Google AI (for image generation)
# ============================================
# Get your API key from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# ============================================
# EMAIL DELIVERY (SendGrid)
# ============================================
# Get your API key from: https://sendgrid.com/
# Free tier: 100 emails/day
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=your-verified@email.com
FROM_NAME=AI Photo Booth

# ============================================
# PUBLIC HOSTING
# ============================================
# For QR codes and email gallery links to work
# Options:
#   - Local network: http://192.168.1.100:8000
#   - Cloudflare tunnel: https://random-name.trycloudflare.com
#   - Cloud deployment: https://booth.yourdomain.com
PUBLIC_BASE_URL=http://localhost:8000

# ============================================
# CAMERA BRIDGE (Optional)
# ============================================
SDK_BRIDGE_URL=http://localhost:9001

# ============================================
# SECURITY (Optional)
# ============================================
# Require PIN for admin operations (watcher, prompts)
# Leave blank to disable PIN protection
APP_PIN=

# CORS: comma-separated list of allowed origins
# Use * for public access
APP_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
